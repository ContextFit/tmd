---
type: table
schema:
  id: int (pk)
  name: text
  company: ref(companies)
  amount: decimal
  due_date: date
  paid: bool
  notes: text?
computed:
  total_revenue: SUM(amount)
  outstanding: SUM(amount WHERE paid=false)
  paid_total: SUM(amount WHERE paid=true)
  avg_invoice: AVG(amount)
  count_unpaid: COUNT(WHERE paid=false)
---

